import pandas as pd

def user_activity(activity: pd.DataFrame) -> pd.DataFrame:
    mask = (activity['activity_date'] >= '2019-06-28') & (activity['activity_date'] <= '2019-07-27')
    return activity.loc[mask].groupby('activity_date', as_index=False)['user_id'].nunique().rename(columns={'activity_date': 'day', 'user_id': 'active_users'})
