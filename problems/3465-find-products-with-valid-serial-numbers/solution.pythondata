import pandas as pd

def find_valid_serial_products(products: pd.DataFrame) -> pd.DataFrame:
    pattern = r"SN\d{4}-\d{4}(?!\d)"
    return products[products["description"].str.contains(pattern, regex=True, na=False)].sort_values("product_id")
